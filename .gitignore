# Local data artifacts — never tracked
corpus_real/
renders/
reference_sets/
*.npz
*.pkl
*.wav
*.flac
*.mp3
.chansplit_cache/
.mixcache/
__pycache__/
.pytest_cache/
debug/
corpus/
cache/
.claude/worktrees/
samples/

# legacy snapshots are FULLY tracked (H-1): negate the data excludes for them
!legacy/**
*.etsworld

# Python build artifacts
*.egg-info/
build/
dist/

# environment disk-guard runtime log (not project content)
disk_guard.log

# derived eigenmode sidecar caches (computed per-deploy on the writable volume)
*.eigen.json
# auto-generated modes-by-temperature sidecar caches (measured per-world on the writable
# volume). The committed, self-contained demo sidecar is the ONE exception (R5) so a fresh
# clone shows the temperature axis without recomputing.
*.sweep.json
!demo.etsworld.sweep.json
